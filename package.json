{
  "name": "@cordfuse/barcoding-mcp",
  "version": "0.0.1",
  "description": "MCP server: encode 100+ barcode symbologies (bwip-js), decode common 1D/2D (zxing-wasm), ASCII/terminal QR (qrcode). Zero native deps. stdio + streamable HTTP.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "barcoding-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bwip-js": "^4.5.1",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8",
    "zxing-wasm": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
