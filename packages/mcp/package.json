{
  "name": "@cordfuse/barcoding-mcp",
  "version": "0.2.0",
  "description": "MCP server: encode 100+ barcode symbologies (bwip-js), decode common 1D/2D (zxing-wasm), ASCII/terminal QR (qrcode). Zero native deps. stdio + streamable HTTP.",
  "license": "MIT",
  "type": "module",
  "author": "Cordfuse",
  "homepage": "https://github.com/cordfuse/barcoding-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cordfuse/barcoding-mcp.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/cordfuse/barcoding-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "barcode",
    "qrcode",
    "datamatrix",
    "pdf417",
    "bwip-js",
    "zxing",
    "encode",
    "decode"
  ],
  "bin": {
    "barcoding-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:options": "node scripts/gen-options.mjs",
    "build": "tsc && node scripts/copy-data.mjs",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bwip-js": "^4.5.1",
    "mupdf": "^1.28.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8",
    "zxing-wasm": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
